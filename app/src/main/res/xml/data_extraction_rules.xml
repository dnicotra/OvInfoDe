<?xml version="1.0" encoding="utf-8"?>
<!-- Favourites are kept in DataStore; allow them in backups and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
