    <!-- Attribution / about -->
    <string name="attribution">Data: Transitous · © OpenStreetMap contributors</string>
    <string name="about_description">Live departures for buses, trams, U-Bahn, S-Bahn and trains in Germany (and beyond): nearby stops, favourites, delays and cancellations at a glance.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_data_title">Data sources</string>
    <string name="about_data_text">Timetables and real-time data are provided by Transitous, a free, community-run public transport service. For Germany it uses the nationwide DELFI timetables and real-time feeds. Stops and maps are based on OpenStreetMap.</string>
    <string name="about_link_sources">Transitous data sources and licences</string>
    <string name="about_link_osm">OpenStreetMap copyright</string>
    <string name="about_link_donate">Support Transitous with a donation</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_text">The app has no account, no ads and no tracking. To find nearby stops, the area around your location is sent to the Transitous server. Favourites are stored only on this device.</string>
    <string name="about_source_title">Source code</string>
    <string name="about_link_source">Source code on GitHub</string>
